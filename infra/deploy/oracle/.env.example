# Impostazioni dell'installazione di produzione (Oracle Cloud o qualsiasi VPS).
# Copiare in .env SULLA MACCHINA (mai nel repository); docs/deploy-vps.md (passo 7) lo genera
# direttamente sulla macchina con password casuali.
# Generare ogni password con:  openssl rand -base64 24

# --- Indirizzo pubblico -----------------------------------------------------------------------
# Nome a dominio che punta all'IP pubblico della macchina (es. civilbeefy.duckdns.org).
APP_DOMAIN=
# Email per Let's Encrypt (avvisi sui certificati).
ACME_EMAIL=

# --- Immagini (pubblicate dal workflow "Release immagini") --------------------------------------
IMAGE_REGISTRY=ghcr.io/giorgiorest
# Lo aggiorna il workflow "Deploy" a ogni rilascio (sha-<commit>).
IMAGE_TAG=latest

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=
# Ruolo con cui si collega l'API (creato da db-init).
DB_PASSWORD=
# Utente del database di Keycloak (creato da db-init).
KEYCLOAK_DB_PASSWORD=

# --- Keycloak ---------------------------------------------------------------------------------
# Amministratore temporaneo, solo per il primo accesso a https://<APP_DOMAIN>/sso/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Azienda demo -----------------------------------------------------------------------------
# true = crea l'azienda demo con dati di esempio (id 00000000-0000-7000-8000-00000000de00),
# a cui associare gli utenti di prova creati in Keycloak.
DEMO_ENABLED=true

# --- Email delle notifiche (facoltativo) --------------------------------------------------------
# Esempio con Brevo (piano gratuito): SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Civil Beefy <noreply@example.com>

# --- Marchio del cliente (facoltativo) ----------------------------------------------------------
BRAND_NAME=
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=
BRAND_ACCENT_COLOR=

# --- Documenti legali (pagina «Privacy e cookie» dell'app) --------------------------------------
# Informativa privacy del titolare del trattamento (l'azienda cliente o chi offre il servizio)
# e condizioni d'uso. URL assoluti o relativi al sito. Vedi docs/privacy-gdpr.md.
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=

# --- Console di piattaforma (docs/console-piattaforma.md) --------------------------------------
# Segreto del client con cui l'API gestisce gli utenti delle aziende in Keycloak:
#   openssl rand -hex 32   (lo genera Prepara server)
PLATFORM_KEYCLOAK_CLIENT_SECRET=
# Reti da cui si raggiungono la console, il login degli amministratori e la console di Keycloak,
# separate da spazi (es. "203.0.113.10 198.51.100.0/24"). Vuoto = da qualsiasi rete.
ADMIN_ALLOWED_IPS=
