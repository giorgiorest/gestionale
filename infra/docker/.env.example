# Copiare in infra/docker/.env (non committato).
# Le password qui sotto sono SOLO PER LO SVILUPPO LOCALE e coincidono con i default del profilo
# "dev" dell'API (./mvnw spring-boot:run funziona senza altre impostazioni).
# Per un'installazione reale cambiarle tutte.

# Database: utente proprietario (migrazioni Flyway)
POSTGRES_DB=gestionale
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=gestionale

# Database: ruolo dell'applicazione (non superuser, soggetto a RLS)
DB_URL=jdbc:postgresql://db:5432/gestionale
DB_USER=gestionale_app
DB_PASSWORD=gestionale_app

# Profilo Spring: dev crea anche il tenant demo
SPRING_PROFILES_ACTIVE=dev

# Keycloak (provider di identità)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# URL pubblico di Keycloak (issuer dei token = KEYCLOAK_URL/realms/gestionale)
KEYCLOAK_URL=http://localhost:8180
# URL della web app (uguale per "npm start" e per il container web)
GESTIONALE_WEB_URL=http://localhost:4200

# Email delle notifiche: in sviluppo Mailpit (http://localhost:8025); in produzione l'SMTP dell'azienda.
EMAIL_ENABLED=true
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=Civil Beefy <noreply@localhost>
# false = nelle email solo titolo e link, senza il testo (comunicazioni riservate)
EMAIL_INCLUDE_BODY=true

# Marchio dell'installazione (facoltativo): nome, logo (URL), colore principale e di accento #RRGGBB
BRAND_NAME=
BRAND_LOGO_URL=
BRAND_PRIMARY_COLOR=
BRAND_ACCENT_COLOR=

# Chiave pubblica Ed25519 (Base64) per verificare le licenze offline
LICENSE_PUBLIC_KEY=

# Assistente AI: "none" = disattivato
AI_PROVIDER=none
AI_API_KEY=
