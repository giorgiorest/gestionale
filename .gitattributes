# Fine riga normalizzati a LF nel repository e nella copia di lavoro, anche su Windows:
# gli script eseguiti in Linux (container, CI) falliscono con CRLF
# ("cannot execute: required file not found").
* text=auto eol=lf

# Script Windows: CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binari.
*.png binary
*.ico binary
*.jpg binary
*.jar binary
