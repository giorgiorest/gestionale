{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Civil Beefy",
  "version": "0.1.0",
  "identifier": "it.gestionale.desktop",
  "build": {
    "frontendDist": "../../web/dist/web/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm --prefix ../web start",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Civil Beefy",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Civil Beefy",
    "shortDescription": "Civil Beefy — gestionale aziendale",
    "longDescription": "App desktop di Civil Beefy: si collega al server della propria azienda.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "it-IT"
      },
      "nsis": {
        "languages": [
          "Italian"
        ]
      }
    }
  }
}
